# ─── Banco de dados (PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://crm:senha@localhost:5432/bt_crm"
DB_POOL_MAX=10

# ─── App ───────────────────────────────────────────────────────
PORT=3100
# Domínio raiz do SaaS: tenants ganham <slug>.crm.businesstriage.com.br
ROOT_DOMAIN="crm.businesstriage.com.br"
# Tenant usado quando o host não bate com nenhum (localhost, IP etc.)
DEFAULT_TENANT_SLUG="business-triage"
# Segredo do JWT de sessão (gere com: openssl rand -base64 48)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
# Segredo para rotas de cron (/api/cron/*)
CRON_SECRET="troque-este-tambem"

# ─── Uploads (disco local; troque por S3/R2 em escala) ─────────
UPLOAD_DIR="./data/uploads"

# ─── E-mail (SMTP) ─────────────────────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="crm@businesstriage.com.br"
SMTP_PASS=""
SMTP_FROM="Business Triage CRM <crm@businesstriage.com.br>"

# ─── WhatsApp (Evolution API) — padrão global; cada tenant pode sobrescrever
EVOLUTION_API_URL="https://evolution.seudominio.com.br"
EVOLUTION_API_KEY=""

# IA que move os cards (Anthropic). Opcional: também pode ir em Configurações → Integrações
ANTHROPIC_API_KEY=""
# AI_MODEL="claude-haiku-4-5"

# ─── Instagram (Meta Graph API) ────────────────────────────────
META_VERIFY_TOKEN="token-de-verificacao-do-webhook"
NEXT_PUBLIC_ROOT_DOMAIN="crm.businesstriage.com.br"
